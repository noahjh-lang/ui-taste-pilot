{
  "name": "tastepilot-web-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @tastepilot/web",
    "build": "npm run build -w @tastepilot/web",
    "preview": "npm run preview -w @tastepilot/web",
    "lint": "eslint packages infra && npm run lint -w @tastepilot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e -w @tastepilot/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && npm run deploy -w @tastepilot/infra",
    "deploy:diff": "npm run build && npm run diff -w @tastepilot/infra",
    "deploy:destroy": "npm run destroy -w @tastepilot/infra",
    "check:bundle": "npm run check:bundle -w @tastepilot/web",
    "storybook": "npm run storybook -w @tastepilot/ui",
    "build-storybook": "npm run build-storybook -w @tastepilot/ui"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
